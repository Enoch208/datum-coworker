PORT=8790
HOST=127.0.0.1
DATABASE_URL=postgres://datum:datum@localhost:54330/datum
# The public web origin, not this API. Every link Datum hands out is built from it:
# QR targets (/c/), card files (/assets/cmp_), evidence photos (/evidence/) and runner links (/r/).
# The web server proxies /api, /c/, /assets/cmp_ and /evidence/ to this API, so locally it is the
# Vite dev server and in production it is the site's own https origin.
APP_BASE_URL=http://localhost:5180
ASSET_DIR=
EVIDENCE_DIR=
ANTHROPIC_API_KEY=
OPERATOR_KEY=
DATUM_PRINT_COST_PER_COPY=
DATUM_PLACEMENT_COST_PER_SPOT=
